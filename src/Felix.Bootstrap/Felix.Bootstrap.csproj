<Project Sdk="Microsoft.NET.Sdk">
  <!-- Le démarreur : une petite application console compilée en Native AOT
       (pas besoin d'installer .NET sur l'ordinateur du joueur, quelques Mo seulement).
       Windows, Linux et macOS. Native AOT se compile sur le système visé : c'est ce que fait le workflow GitHub. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Felix.Bootstrap</RootNamespace>
    <AssemblyName>FelixBootstrap</AssemblyName>
    <!-- Numéro de version : fixé automatiquement par la compilation GitHub (-p:Version=1.0.NN).
         « 0.0.0 » = lancé depuis le code source. -->
    <Version>0.0.0</Version>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <!-- Quand tu auras ton logo en .ico, décommente : -->
    <!-- <ApplicationIcon>logo.ico</ApplicationIcon> -->
  </PropertyGroup>
</Project>
