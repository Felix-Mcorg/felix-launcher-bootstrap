<Project Sdk="Microsoft.NET.Sdk">
  <!-- Le démarreur : une petite application console compilée en Native AOT
       (pas besoin d'installer .NET sur l'ordinateur du joueur, quelques Mo seulement). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Felix.Bootstrap</RootNamespace>
    <AssemblyName>FelixBootstrap</AssemblyName>
    <Version>1.0.0</Version>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <!-- Quand tu auras ton logo en .ico, décommente : -->
    <!-- <ApplicationIcon>logo.ico</ApplicationIcon> -->
  </PropertyGroup>
</Project>
